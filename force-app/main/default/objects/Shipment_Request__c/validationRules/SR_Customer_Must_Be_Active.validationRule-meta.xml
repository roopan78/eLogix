<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SR_Customer_Must_Be_Active</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT($Permission.eLogix_Bypass_Validation_Rules),
    AND(
        OR(ISNEW(), ISCHANGED(Customer__c)),
        NOT(Customer__r.Is_Active_Customer__c)
    )
)</errorConditionFormula>
    <errorDisplayField>Customer__c</errorDisplayField>
    <errorMessage>Inactive customers cannot raise new shipment requests. Reactivate the customer first.</errorMessage>
</ValidationRule>
