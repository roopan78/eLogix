<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SR_Delivery_After_Pickup</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT($Permission.eLogix_Bypass_Validation_Rules),
    AND(
        NOT(ISBLANK(Expected_Delivery_Date__c)),
        Expected_Delivery_Date__c &lt;= Requested_Pickup_Date__c
    )
)</errorConditionFormula>
    <errorDisplayField>Expected_Delivery_Date__c</errorDisplayField>
    <errorMessage>Expected delivery date must be after the requested pickup date.</errorMessage>
</ValidationRule>
