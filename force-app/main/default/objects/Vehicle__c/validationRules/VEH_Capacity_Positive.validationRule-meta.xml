<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VEH_Capacity_Positive</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT($Permission.eLogix_Bypass_Validation_Rules),
    Capacity__c &lt;= 0
)</errorConditionFormula>
    <errorDisplayField>Capacity__c</errorDisplayField>
    <errorMessage>Vehicle capacity must be greater than zero.</errorMessage>
</ValidationRule>
