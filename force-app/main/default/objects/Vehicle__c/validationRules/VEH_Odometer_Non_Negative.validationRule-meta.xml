<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VEH_Odometer_Non_Negative</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT($Permission.eLogix_Bypass_Validation_Rules),
    Current_Odometer__c &lt; 0
)</errorConditionFormula>
    <errorDisplayField>Current_Odometer__c</errorDisplayField>
    <errorMessage>Odometer reading cannot be negative.</errorMessage>
</ValidationRule>
