<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SM_Movements_Are_Immutable</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT($Permission.eLogix_Bypass_Validation_Rules),
    NOT(ISNEW())
)</errorConditionFormula>
    <errorMessage>Stock movements are an audit trail and cannot be changed. Post a correcting movement instead.</errorMessage>
</ValidationRule>
