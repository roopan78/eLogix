<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>INL_Tax_Values_Valid</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT($Permission.eLogix_Bypass_Validation_Rules),
    OR(Tax_Amount__c &lt; 0, Tax_Percent__c &lt; 0, Tax_Percent__c &gt; 1)
)</errorConditionFormula>
    <errorDisplayField>Tax_Amount__c</errorDisplayField>
    <errorMessage>Tax amount cannot be negative and tax percent must be between 0 and 100.</errorMessage>
</ValidationRule>
