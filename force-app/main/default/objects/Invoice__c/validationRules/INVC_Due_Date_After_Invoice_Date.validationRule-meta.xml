<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>INVC_Due_Date_After_Invoice_Date</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT($Permission.eLogix_Bypass_Validation_Rules),
    AND(NOT(ISBLANK(Due_Date__c)), Due_Date__c &lt; Invoice_Date__c)
)</errorConditionFormula>
    <errorDisplayField>Due_Date__c</errorDisplayField>
    <errorMessage>Due date cannot be before the invoice date.</errorMessage>
</ValidationRule>
