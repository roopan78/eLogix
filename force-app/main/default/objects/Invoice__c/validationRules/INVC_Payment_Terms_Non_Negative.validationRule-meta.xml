<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>INVC_Payment_Terms_Non_Negative</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT($Permission.eLogix_Bypass_Validation_Rules),
    Payment_Terms_Days__c &lt; 0
)</errorConditionFormula>
    <errorDisplayField>Payment_Terms_Days__c</errorDisplayField>
    <errorMessage>Payment terms cannot be negative.</errorMessage>
</ValidationRule>
