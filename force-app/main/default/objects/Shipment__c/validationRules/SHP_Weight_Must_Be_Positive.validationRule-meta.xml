<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SHP_Weight_Must_Be_Positive</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT($Permission.eLogix_Bypass_Validation_Rules),
    Weight__c &lt;= 0
)</errorConditionFormula>
    <errorDisplayField>Weight__c</errorDisplayField>
    <errorMessage>Shipment weight must be greater than zero.</errorMessage>
</ValidationRule>
