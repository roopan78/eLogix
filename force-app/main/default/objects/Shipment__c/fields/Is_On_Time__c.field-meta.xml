<?xml version="1.0" encoding="UTF-8" ?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Is_On_Time__c</fullName>
    <formula
  >AND(NOT(ISBLANK(Actual_Delivery_Date__c)), NOT(ISBLANK(Expected_Delivery_Date__c)), Actual_Delivery_Date__c &lt;= Expected_Delivery_Date__c)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText
  >Delivered on or before the expected delivery date.</inlineHelpText>
    <label>Is On Time</label>
    <type>Checkbox</type>
</CustomField>
