<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VM_Completion_Date_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT($Permission.eLogix_Bypass_Validation_Rules),
    AND(ISPICKVAL(Status__c, &quot;Completed&quot;), ISBLANK(Completion_Date__c))
)</errorConditionFormula>
    <errorDisplayField>Completion_Date__c</errorDisplayField>
    <errorMessage>Enter the completion date before marking maintenance as completed.</errorMessage>
</ValidationRule>
