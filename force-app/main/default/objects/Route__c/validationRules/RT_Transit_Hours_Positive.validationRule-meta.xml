<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RT_Transit_Hours_Positive</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT($Permission.eLogix_Bypass_Validation_Rules),
    AND(NOT(ISBLANK(Estimated_Transit_Hours__c)), Estimated_Transit_Hours__c &lt;= 0)
)</errorConditionFormula>
    <errorDisplayField>Estimated_Transit_Hours__c</errorDisplayField>
    <errorMessage>Estimated transit hours must be greater than zero when entered.</errorMessage>
</ValidationRule>
