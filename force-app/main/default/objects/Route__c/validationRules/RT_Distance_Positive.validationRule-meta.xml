<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RT_Distance_Positive</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT($Permission.eLogix_Bypass_Validation_Rules),
    Distance__c &lt;= 0
)</errorConditionFormula>
    <errorDisplayField>Distance__c</errorDisplayField>
    <errorMessage>Route distance must be greater than zero.</errorMessage>
</ValidationRule>
