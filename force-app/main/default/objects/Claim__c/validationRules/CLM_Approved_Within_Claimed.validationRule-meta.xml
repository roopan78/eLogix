<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CLM_Approved_Within_Claimed</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT($Permission.eLogix_Bypass_Validation_Rules),
    OR(Approved_Amount__c &lt; 0, Approved_Amount__c &gt; Claim_Amount__c)
)</errorConditionFormula>
    <errorDisplayField>Approved_Amount__c</errorDisplayField>
    <errorMessage>Approved amount must be between zero and the claimed amount.</errorMessage>
</ValidationRule>
