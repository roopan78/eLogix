<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RS_Sequence_Positive</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT($Permission.eLogix_Bypass_Validation_Rules),
    Sequence__c &lt;= 0
)</errorConditionFormula>
    <errorDisplayField>Sequence__c</errorDisplayField>
    <errorMessage>Stop sequence must be greater than zero.</errorMessage>
</ValidationRule>
