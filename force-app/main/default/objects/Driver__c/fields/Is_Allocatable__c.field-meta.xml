<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Is_Allocatable__c</fullName>
    <formula>AND(ISPICKVAL(Status__c, &quot;Available&quot;), NOT(ISBLANK(License_Expiry__c)), License_Expiry__c &gt;= TODAY())</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Is Allocatable</label>
    <type>Checkbox</type>
</CustomField>
