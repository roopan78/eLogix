<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Is_License_Valid__c</fullName>
    <formula>AND(NOT(ISBLANK(License_Expiry__c)), License_Expiry__c &gt;= TODAY())</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Is License Valid</label>
    <type>Checkbox</type>
</CustomField>
