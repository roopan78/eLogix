<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>TE_Coordinates_Valid</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT($Permission.eLogix_Bypass_Validation_Rules),
    OR(ABS(BLANKVALUE(Latitude__c, 0)) &gt; 90, ABS(BLANKVALUE(Longitude__c, 0)) &gt; 180)
)</errorConditionFormula>
    <errorDisplayField>Latitude__c</errorDisplayField>
    <errorMessage>Latitude must be between -90 and 90 and longitude between -180 and 180.</errorMessage>
</ValidationRule>
