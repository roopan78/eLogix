<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>TE_Events_Are_Immutable</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT($Permission.eLogix_Bypass_Validation_Rules),
    NOT(ISNEW())
)</errorConditionFormula>
    <errorMessage>Tracking events are shipment history and cannot be changed. Record a new event instead.</errorMessage>
</ValidationRule>
