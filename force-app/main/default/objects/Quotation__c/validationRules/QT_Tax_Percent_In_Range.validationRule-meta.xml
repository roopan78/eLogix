<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>QT_Tax_Percent_In_Range</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT($Permission.eLogix_Bypass_Validation_Rules),
    OR(Tax_Percent__c &lt; 0, Tax_Percent__c &gt; 1)
)</errorConditionFormula>
    <errorDisplayField>Tax_Percent__c</errorDisplayField>
    <errorMessage>Tax percent must be between 0 and 100.</errorMessage>
</ValidationRule>
