<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Is_Open__c</fullName>
    <formula>OR(ISPICKVAL(Status__c, &quot;Planned&quot;), ISPICKVAL(Status__c, &quot;Active&quot;))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Open assignments are the ones that can conflict with a new allocation.</inlineHelpText>
    <label>Is Open</label>
    <type>Checkbox</type>
</CustomField>
