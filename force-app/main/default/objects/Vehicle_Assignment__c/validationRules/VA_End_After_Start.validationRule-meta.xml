<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VA_End_After_Start</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT($Permission.eLogix_Bypass_Validation_Rules),
    AND(NOT(ISBLANK(Assignment_End__c)), Assignment_End__c &lt;= Assignment_Start__c)
)</errorConditionFormula>
    <errorDisplayField>Assignment_End__c</errorDisplayField>
    <errorMessage>Assignment end must be after assignment start.</errorMessage>
</ValidationRule>
