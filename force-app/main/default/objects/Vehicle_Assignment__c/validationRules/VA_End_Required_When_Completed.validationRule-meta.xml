<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VA_End_Required_When_Completed</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT($Permission.eLogix_Bypass_Validation_Rules),
    AND(ISPICKVAL(Status__c, &quot;Completed&quot;), ISBLANK(Assignment_End__c))
)</errorConditionFormula>
    <errorDisplayField>Assignment_End__c</errorDisplayField>
    <errorMessage>A completed assignment must have an end date and time.</errorMessage>
</ValidationRule>
