<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>STK_Reorder_Level_Non_Negative</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT($Permission.eLogix_Bypass_Validation_Rules),
    Reorder_Level__c &lt; 0
)</errorConditionFormula>
    <errorDisplayField>Reorder_Level__c</errorDisplayField>
    <errorMessage>Reorder level cannot be negative.</errorMessage>
</ValidationRule>
