<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>STK_Reserved_Within_Available</fullName>
    <active>true</active>
    <errorConditionFormula>BLANKVALUE(Reserved_Quantity__c, 0) &gt; BLANKVALUE(Available_Quantity__c, 0)</errorConditionFormula>
    <errorDisplayField>Reserved_Quantity__c</errorDisplayField>
    <errorMessage>Reserved quantity cannot exceed available quantity.</errorMessage>
</ValidationRule>
