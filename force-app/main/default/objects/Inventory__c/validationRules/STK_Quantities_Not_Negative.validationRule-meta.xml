<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>STK_Quantities_Not_Negative</fullName>
    <active>true</active>
    <errorConditionFormula>OR(BLANKVALUE(Available_Quantity__c, 0) &lt; 0, BLANKVALUE(Reserved_Quantity__c, 0) &lt; 0)</errorConditionFormula>
    <errorDisplayField>Available_Quantity__c</errorDisplayField>
    <errorMessage>Stock cannot become negative.</errorMessage>
</ValidationRule>
